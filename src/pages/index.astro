<script is:inline>
(function(){
var P=[
{id:"civil",n:"Noiva Civil",p:500,d:"Maquiagem profissional e penteado"},
{id:"essencial",n:"Essencial",p:700,d:"Maquiagem profissional, penteado e robe de noiva"},
{id:"completo",n:"Completo",p:1100,d:"Maquiagem profissional, penteado, teste e robe"},
{id:"premium",n:"Premium",p:2090,d:"Completo, spa, coffee break e 4h de assessoria"}
];
var MAQ=200,PEN=180,DESL=100,TESTE=400,MAKING=350,COFFEE=35,ASS_HORA=100,NUM="5592985258948";
var $=function(i){return document.getElementById(i)};
var brl=function(v){return v.toLocaleString("pt-BR",{style:"currency",currency:"BRL"})};
var q={maq:0,pen:0,coffee:0,ass:0};
var lastPkgId="completo";
var box=$("pk");
P.forEach(function(x){
 var l=document.createElement("label");l.className="op";
 l.innerHTML='<input type="radio" name="pkg" value="'+x.id+'"'+(x.id==="completo"?" checked":"")+'><span>'+x.n+'<br><span class="small">'+x.d+'</span></span><b>'+brl(x.p)+'</b>';
 box.appendChild(l);
});
function get(n){var e=document.querySelector('input[name="'+n+'"]:checked');return e?e.value:""}
function upd(){
 var pk=P.filter(function(x){return x.id===get("pkg")})[0]||P[2];
 if(pk.id!==lastPkgId){
  if((pk.id==="premium")!==(lastPkgId==="premium")){
   q.ass=0;
  }
  lastPkgId=pk.id;
 }
 var ext=get("loc")==="ext";
 var teste=$("teste").checked && pk.id==="essencial"?TESTE:0;
 var making=$("making").checked && MAKING;
 var coffee=pk.id==="premium"?q.coffee*COFFEE:0;
 var assCost=q.ass*ASS_HORA;
 var ad=q.maq*MAQ+q.pen*PEN+teste+making+coffee+assCost, ds=ext?DESL:0;
 var tot=pk.p+ad+ds, sin=tot/2;
 $("r1").textContent=pk.n+" "+brl(pk.p);
 
 var txt=[];
 if(q.maq)txt.push(q.maq+" maquiagem");
 if(q.pen)txt.push(q.pen+" penteado");
 if(pk.id==="premium"){
  if(q.ass)txt.push(q.ass+"h extra(s) de assessoria ("+brl(assCost)+")");
 }else{
  if(q.ass)txt.push(q.ass+"h de assessoria ("+brl(assCost)+")");
 }
 if(teste)txt.push("teste completo");
 if(making)txt.push("Making Of");
 if(coffee)txt.push(q.coffee+" pessoa(s) extra(s) no coffee break");
 
 $("r2").textContent=txt.length?txt.join(", ")+" — "+brl(ad):"Nenhum";
 $("r3").textContent=ext?brl(DESL):"Não se aplica";
 $("tt").textContent=brl(tot);$("sn").textContent=brl(sin);$("rs").textContent=brl(tot-sin);
 
 $("teste").disabled=pk.id!=="essencial";
 if(pk.id!=="essencial")$("teste").checked=false;
 $("making").disabled=false;
 
 var assOut=$("ass"), assNote=$("ass-note");
 if(pk.id==="premium"){
  if(assOut) assOut.textContent=q.ass?(4+q.ass)+"h":"4h";
  if(assNote) assNote.textContent=q.ass?("4h inclusas + "+q.ass+"h adicional ("+brl(assCost)+")"):"4 horas já inclusas no Premium (+ R$ 100/h extra)";
 }else{
  if(assOut) assOut.textContent=q.ass?q.ass+"h":"0h";
  if(assNote) assNote.textContent=q.ass?(q.ass+" horas selecionadas ("+brl(assCost)+")"):"Mínimo de 2 horas (R$ 200,00)";
 }
 
 ["maq","pen","coffee"].forEach(function(k){var el=$(k);if(el)el.textContent=String(q[k]);});
 
 var coffeeStep=document.querySelector('[data-s="coffee"]').closest('.step');
 coffeeStep.style.opacity=pk.id==="premium"?"1":".55";
 coffeeStep.querySelectorAll("button").forEach(function(btn){btn.disabled=pk.id!=="premium";});
 
 var nome=$("nome").value.trim(),email=$("email").value.trim(),dt=$("data").value,dd=dt?dt.split("-").reverse().join("/"):"",hora=$("hora").value;
 var m="Olá! Montei meu orçamento de noiva no site do Beleza de Mar.\nNome: "+nome+"\n"+(email?"E-mail: "+email+"\n":"")+"Pacote: "+pk.n+" ("+brl(pk.p)+")\nAtendimento: "+(ext?"no local do evento ou hotel (deslocamento "+brl(DESL)+")":"no estúdio")+"\n"+(txt.length?"Adicionais: "+txt.join(", ")+"\n":"")+"Data do casamento: "+dd+"\nHorário previsto do evento: "+hora+"\nValor estimado: "+brl(tot)+" (sinal de 50%: "+brl(sin)+")\nGostaria de verificar a disponibilidade.";
 $("zap").href="https://wa.me/"+NUM+"?text="+encodeURIComponent(m);
}
document.addEventListener("change",function(e){if(e.target.name==="pkg"||e.target.name==="loc"||e.target.id==="data"||e.target.id==="teste"||e.target.id==="making"||e.target.id==="hora"||e.target.id==="email")upd()});
["nome","email","data","hora"].forEach(function(id){$(id).addEventListener("input",upd)});
$("zap").addEventListener("click",function(e){
 var nome=$("nome"),data=$("data"),hora=$("hora"),email=$("email");
 if(!nome.value.trim()){e.preventDefault();nome.setCustomValidity("Por favor, informe seu nome.");nome.reportValidity();nome.focus();return;}else{nome.setCustomValidity("")}
 if(!data.value){e.preventDefault();data.setCustomValidity("Informe a data do casamento.");data.reportValidity();data.focus();return;}else{data.setCustomValidity("")}
 if(!hora.value){e.preventDefault();hora.setCustomValidity("Informe o horário previsto do evento.");hora.reportValidity();hora.focus();return;}else{hora.setCustomValidity("")}
 if(email.value.trim()&&!email.checkValidity()){e.preventDefault();email.reportValidity();email.focus();return;}
 upd();
});
document.addEventListener("click",function(e){
 var b=e.target && e.target.closest ? e.target.closest("button[data-s][data-d]") : null;
 if(!b) return;
 e.preventDefault();
 var k=b.getAttribute("data-s");
 if(!Object.prototype.hasOwnProperty.call(q,k)) return;
 var delta=parseInt(b.getAttribute("data-d"),10);
 if(!Number.isFinite(delta)) return;
 var pk=P.filter(function(x){return x.id===get("pkg")})[0]||P[2];
 if(k==="ass"){
  if(pk.id==="premium"){
   q.ass=Math.max(0,Math.min(6,q.ass+delta));
  }else{
   if(delta>0){
    if(q.ass===0) q.ass=2;
    else q.ass=Math.min(8,q.ass+1);
   }else{
    if(q.ass<=2) q.ass=0;
    else q.ass=q.ass-1;
   }
  }
 }else{
  var max=k==="coffee"?6:9;
  q[k]=Math.max(0,Math.min(max,q[k]+delta));
 }
 upd();
},true);
document.querySelectorAll("[data-p]").forEach(function(b){b.addEventListener("click",function(){
 var r=document.querySelector('input[name="pkg"][value="'+b.dataset.p+'"]');if(r){r.checked=true;upd()}
 $("orcamento").scrollIntoView({behavior:window.matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth"});if(r)r.focus({preventScroll:true});
})});
upd();
var floatingZap=document.querySelector(".pill"), finalContact=document.querySelector(".fim");
if(floatingZap && finalContact && "IntersectionObserver" in window){
 var zapObserver=new IntersectionObserver(function(entries){floatingZap.classList.toggle("is-hidden",entries[0].isIntersecting)},{threshold:0.12});
 zapObserver.observe(finalContact);
}
})();
</script>
